{
  "name": "Face-Pause",
  "version": "0.1.0",
  "description": "Experimental Chrome Extension - Look Away to Pause Youtube",
  "scripts": {
    "build": "npm run chrome-build && npm run firefox-build",
    "chrome-build": "node scripts/build.mjs chrome",
    "firefox-build": "node scripts/build.mjs firefox",
    "chrome-watch": "node scripts/build.mjs chrome --watch",
    "firefox-watch": "node scripts/build.mjs firefox --watch",
    "chrome-dist": "node scripts/build.mjs chrome --zip",
    "firefox-dist": "node scripts/build.mjs firefox --zip",
    "dist": "npm run chrome-dist && npm run firefox-dist",
    "test": "node --test test/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hemmingsson/FacePause"
  },
  "author": "Mattias <hemmingsson.m@gmail.com> (https://github.com/Hemmingsson)",
  "bugs": {
    "url": "https://github.com/Hemmingsson/FacePause/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.108.2",
    "fflate": "^0.8.3"
  },
  "dependencies": {
    "sentinel-js": "0.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
